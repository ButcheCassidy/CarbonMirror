    { "ip": "Pixel-10-Pro-XL", "expect": "IpHostnameRefused" },
    { "ip": "localhost", "expect": "IpHostnameRefused" },
    { "ip": "", "expect": "IpMalformed" },
    { "ip": "192.168.1", "expect": "IpMalformed" },
    { "ip": "192.168.1.256", "expect": "IpMalformed" },
    { "ip": "192.168.01.20", "expect": "IpMalformed" },
    { "ip": "192.168.1.20; rm -rf /", "expect": "IpMalformed" },
